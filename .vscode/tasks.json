{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: spring-boot:run (dev)",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": [
        "spring-boot:run",
        { "value": "-Dspring-boot.run.profiles=dev", "quoting": "strong" }
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "frontend: ng serve",
      "type": "shell",
      "command": "npx",
      "args": ["ng", "serve"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "dev: backend + frontend",
      "dependsOn": ["backend: spring-boot:run (dev)", "frontend: ng serve"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
